{
  "hooks": {
    "preToolUse": [
      {
        "command": "bash .cursor/ptuf-hook.sh",
        "failClosed": true,
        "matcher": "Shell|Bash|Read|ReadFile|Grep|Write|Edit|Delete|MCP|WebFetch|Fetch|mcp__.*",
        "timeout": 10,
        "type": "command"
      }
    ]
  },
  "version": 1
}
